_rpmdev_newspec () 
{ 
    COMPREPLY=();
    local i;
    for i in ${COMP_WORDS[@]};
    do
        [[ "$i" == -@(h|-help|v|-version) ]] && return;
    done;
    local cur prev;
    _rpmdev_curprev "$2" "$3";
    case $prev in 
        -o | --output)
            _filedir spec;
            return
        ;;
        -t | --type)
            COMPREPLY=($(command ls /etc/rpmdevtools/spectemplate-*.spec 2> /dev/null));
            COMPREPLY=(${COMPREPLY[@]%.spec});
            COMPREPLY=(${COMPREPLY[@]#/etc/rpmdevtools/spectemplate-});
            COMPREPLY=($(compgen -W '${COMPREPLY[@]}' -- "$cur"));
            return
        ;;
        -r | --rpm-version)
            COMPREPLY=($(compgen -W '4.3 4.4 4.6 4.8 4.11 4.12' -- "$cur"));
            return
        ;;
    esac;
    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W '--output --type --macros --rpm-version
            --help --version' -- "$cur"));
    else
        _filedir spec;
    fi;
    _rpmdev_uniqargs
}
