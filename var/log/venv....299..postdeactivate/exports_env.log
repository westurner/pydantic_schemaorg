_usrlog_append () 
{ 
    local cmd="${*}";
    local prefix="${VENVPREFIX:-${VIRTUAL_ENV}}";
    ( printf "#  %s\t%s\t%s\t%s\t%s\n" "$(date +%Y-%m-%dT%H:%M:%S%z)" "$(echo "${_TERM_ID}" | tr '	' ' ')" "$(echo "${prefix}" | tr '	' ' ')" "$(echo "${PWD}" | tr '	' ' ')" "$(echo "${cmd}" | tr '
' ' ')" ) >> "${_USRLOG:-${__USRLOG}}" 2> /dev/null;
    printf "%s\n" "$(echo "${cmd}" | sed 's|.*	$$	\(.*\)|#  \1|g')"
}
_usrlog_echo_paths () 
{ 
    _usrlog_set_usrlog_paths;
    printf '%s\n' "${_USRLOG_PATHS[@]}"
}
_usrlog_echo_title () 
{ 
    local title="${WINDOW_TITLE:+"$WINDOW_TITLE "}";
    local venvtitle="${_APP:-${VIRTUAL_ENV_NAME}}";
    if [ -n "${venvtitle}" ]; then
        title="($venvtitle) ${title}";
    fi;
    title="${title} ${USER}@${HOSTNAME}:${PWD}${venvtitle:+" - [${venvtitle^^}]"}";
    local USRLOG_WINDOW_TITLE=${title:-"$@"};
    if [ -n $CLICOLOR ]; then
        echo -ne "\033]0;${USRLOG_WINDOW_TITLE}\007";
    fi
}
_usrlog_get__TERM_ID () 
{ 
    echo "#  _TERM_ID="$_TERM_ID" # [ $_USRLOG ]" 1>&2;
    echo "$_TERM_ID"
}
_usrlog_get_prefix () 
{ 
    local prefix="${VENVPREFIX:-${VIRTUAL_ENV:-${HOME}}}";
    if [ "${prefix}" == "/" ]; then
        prefix=$HOME;
    fi;
    echo "$prefix"
}
_usrlog_grep_todo_fixme_xxx () 
{ 
    grep --color=auto --text -E -i '(todo|fixme|xxx)'
}
_usrlog_grep_todos () 
{ 
    grep --color=auto --text '$$''	''#\(TODO\|NOTE\|_MSG\)'
}
_usrlog_grep_venvs () 
{ 
    grep --color=auto -E ${@} '((we[c]?)|workon_venv|workon_conda|workon|mkvirtualenv|mkvirtualenv_conda|rmvirtualenv|rmvirtualenv_conda)[ ;]'
}
_usrlog_log_cmd_and_update_prompt () 
{ 
    _usrlog_log_cmd_and_update_prompt_setxstate=${-//[^x]/};
    set +x;
    _usrlog_writecmd;
    _usrlog_echo_title;
    if [[ -n "${_usrlog_log_cmd_and_update_prompt_setxstate}" ]]; then
        set -x;
    fi
}
_usrlog_parse_cmds () 
{ 
    local usrlog="${1}";
    sed 's,.*\t\$\$\t\(.*\),\1,g' ${usrlog:+"${usrlog}"}
}
_usrlog_parse_newstyle () 
{ 
    local usrlog="${1}";
    if [ -n "${usrlog}" ]; then
        if [ "${usrlog}" != "-" ]; then
            usrlog="-f ${usrlog}";
        fi;
    fi;
    pyline.py "${usrlog}" -m collections '[collections.OrderedDict((
            ("l", [l]),
            ("date", w[0].lstrip("#  ")),
            ("id", w[1]),
            ("path", w[2]),
            ("virtualenv", w[3]),
            ("histstr", w[4:]),
            ("histn", w[4].strip()),    #  int or {#NOTE, #TODO, #_MSG}
            ("histdate", (w[5] if len(w) > 5 else None)),
            ("histhostname", (w[6] if len(w) > 6 else None)),
            ("histuser", (w[7] if len(w) > 7 else None)),
            ("histcmd", (w[9:] if len(w) > 9 else None)),
            ))
            for w in [ line.split("\t", 9) ]
                if len(w) >= 4]' -O json
}
_usrlog_randstr () 
{ 
    if [[ `uname -s` == "Darwin" ]]; then
        echo "$(dd if=/dev/urandom bs=1 count=$1 2> /dev/null | base64 -b 0 | rev | cut -b 2- | tr '/+' '0' | rev)";
    else
        echo "$(dd if=/dev/urandom bs=1 count=$1 2> /dev/null | base64 -w 0 | rev | cut -b 2- | tr '/+' '0' | rev)";
    fi
}
_usrlog_set_HIST () 
{ 
    HISTSIZE=1000;
    HISTFILESIZE=1000000;
    HISTTIMEFORMAT="%t%Y-%m-%dT%H:%M:%S%z%t${HOSTNAME}%t${USER}%t\$\$%t";
    HISTCONTROL=ignoredups:ignorespace;
    _usrlog_set_HISTFILE;
    if [ -n "$ZSH_VERSION" ]; then
        setopt APPEND_HISTORY;
        setopt EXTENDED_HISTORY;
    else
        if [ -n "$BASH" ]; then
            history -a;
            shopt -s histappend > /dev/null 2>&1;
            shopt -s cmdhist > /dev/null 2>&1;
            shopt -s lithist > /dev/null 2>&1;
            shopt -s autocd > /dev/null 2>&1;
        fi;
    fi
}
_usrlog_set_HISTFILE () 
{ 
    local prefix="$(_usrlog_get_prefix)";
    if [ -n "${BASH}" ]; then
        history -a;
    fi;
    set HISTFILE;
    if [ -n "${ZSH_VERSION}" ]; then
        export HISTFILE="${prefix}/.zsh_history";
    else
        if [ -n "${BASH}" ]; then
            export HISTFILE="${prefix}/.bash_history";
        else
            export HISTFILE="${prefix}/.history";
        fi;
    fi;
    if [ -n "${BASH}" ]; then
        history -c && history -r "${HISTFILE}";
    fi
}
_usrlog_set__TERM_ID () 
{ 
    local new_term_id="${@}";
    if [ -z "${new_term_id}" ]; then
        new_term_id="#$(_usrlog_randstr 8)";
    fi;
    if [[ "${new_term_id}" != "${_TERM_ID}" ]]; then
        if [ -z "${_TERM_ID}" ]; then
            _usrlog_append "#ntid  _TERM_ID=\"${new_term_id}\"  #_USRLOG=\"${_USRLOG}\"";
        else
            _usrlog_append "#stid  _TERM_ID=\"${new_term_id}\"  #_TERM_ID__=\"${_TERM_ID}\"  #_USRLOG=\"${_USRLOG}\"";
        fi;
        export _TERM_ID="${new_term_id}";
        _usrlog_set_title;
    fi
}
_usrlog_set__USRLOG () 
{ 
    export __USRLOG="${HOME}/-usrlog.log";
    prefix="$(_usrlog_get_prefix)";
    export _USRLOG="${prefix}/-usrlog.log"
}
_usrlog_set_title () 
{ 
    export WINDOW_TITLE=${1:-"$_TERM_ID"};
    _usrlog_echo_title;
    declare -F '_setup_venv_prompt' 2>&1 > /dev/null && _setup_venv_prompt
}
_usrlog_set_usrlog_paths () 
{ 
    declare -ga _USRLOG_PATHS;
    declare -a _usrlog_paths;
    _USRLOG_PATHS=();
    _usrlog_paths=();
    _usrlog_paths+=("${_USRLOG}" "${__USRLOG}");
    test -n "${USRLOG_INCLUDE_LEGACYLOGS}" && _usrlog_paths+=(${WORKON_HOME}/*/.usrlog);
    test -n "${WORKON_HOME}" && _usrlog_paths+=(${WORKON_HOME}/*/-usrlog.log);
    test -n "${CONDA_ENVS_PATH}" && _usrlog_paths+=(${CONDA_ENVS_PATH}/*/-usrlog.log);
    test -z "${USRLOG_INCLUDE_ALLUSRLOGS}" && test -n "${__WRK}" && _usrlog_paths+=(${__WRK}/-*/*/-usrlog.log);
    declare -A uniques;
    for pth in "${_usrlog_paths[@]}";
    do
        exists=${uniques["${pth}"]};
        if [ -z "${exists}" ]; then
            uniques["${pth}"]="${pth}";
            _USRLOG_PATHS+=("${pth}");
        fi;
    done;
    export _USRLOG_PATHS
}
_usrlog_setup () 
{ 
    local _usrlog="${1:-$_USRLOG}";
    local term_id="${2:-$_TERM_ID}";
    _usrlog_set_HIST;
    _usrlog_set__USRLOG "$_usrlog";
    TERM_SED_STR='s/^\s*[0-9]*\s*//';
    _usrlog_set__TERM_ID "$term_id";
    touch "$_USRLOG";
    _usrlog_set_title "$_TERM_ID";
    if [ -n "$BASH" ]; then
        PROMPT_COMMAND="_usrlog_log_cmd_and_update_prompt";
    fi;
    if [ -n "$ZSH_VERSION" ]; then
        precmd_functions=(_usrlog_log_cmd_and_update_prompt);
    fi
}
_usrlog_tail () 
{ 
    local _args=${@};
    local _usrlog="${_USRLOG}";
    if [ -n "${_args}" ]; then
        for _arg in ${_args};
        do
            case "${_arg}" in 
                -*)
                    case "${_arg}" in 
                        -n)
                            shift;
                            local count=${1};
                            shift;
                            continue
                        ;;
                        -n*)
                            local count=${_arg#"-n"};
                            shift;
                            continue
                        ;;
                        -f)
                            local follow=1
                        ;;
                        -v)
                            shift;
                            local verbose=1
                        ;;
                        *)
                            echo "_arg: ${_arg}"
                        ;;
                    esac
                ;;
            esac;
        done;
        if [ -z $# ]; then
            _args=($_args "${_usrlog}");
        fi;
        ( set -x;
        tail ${_args[@]} "${_usrlog}" );
    else
        ( set -x;
        tail ${follow:+"-f"} "${_usrlog}" );
    fi
}
_usrlog_writecmd () 
{ 
    _usrlog_set_HISTFILE;
    if [ -n "$ZSH_VERSION" ]; then
        id 2>&1 > /dev/null;
        _cmd=$(fc -l -1 | sed -e "${TERM_SED_STR}");
    else
        if [ -n "$BASH" ]; then
            _cmd=$(history 1 | sed -e "${TERM_SED_STR}");
        else
            _cmd=$(history 1 | sed -e "${TERM_SED_STR}");
        fi;
    fi;
    _usrlog_append "${_cmd}"
}
