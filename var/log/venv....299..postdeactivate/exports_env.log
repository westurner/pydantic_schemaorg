        ;;
        -m)
            local types;
            types=$(ausearch -m 2>&1 | grep -oE '\b[A-Z_]+\b' | sort);
            COMPREPLY=($(compgen -W "$types" -- "$cur"));
            return 0
        ;;
    esac;
    COMPREPLY=($(compgen -W "$_auditctl_opts" -- "$cur"))
}
