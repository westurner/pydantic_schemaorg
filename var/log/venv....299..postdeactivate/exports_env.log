{ 
    local cur prev;
    COMPREPLY=();
    cur="${COMP_WORDS[COMP_CWORD]}";
    prev="${COMP_WORDS[COMP_CWORD-1]}";
    case "$prev" in 
        -S)
            local syscalls;
            syscalls=$(ausyscall --dump 2> /dev/null | cut -f2);
            COMPREPLY=($(compgen -W "$syscalls" -- "$cur"));
