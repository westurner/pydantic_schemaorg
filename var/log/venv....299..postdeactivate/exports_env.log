virtualenvwrapper_original_deactivate=$'virtualenv_deactivate () \n{ \n    unset -f pydoc > /dev/null 2>&1 || true;\n    if ! [ -z "${_OLD_VIRTUAL_PATH:+_}" ]; then\n        PATH="$_OLD_VIRTUAL_PATH";\n        export PATH;\n        unset _OLD_VIRTUAL_PATH;\n    fi;\n    if ! [ -z "${_OLD_VIRTUAL_PYTHONHOME+_}" ]; then\n        PYTHONHOME="$_OLD_VIRTUAL_PYTHONHOME";\n        export PYTHONHOME;\n        unset _OLD_VIRTUAL_PYTHONHOME;\n    fi;\n    hash -r 2> /dev/null;\n    if ! [ -z "${_OLD_VIRTUAL_PS1+_}" ]; then\n        PS1="$_OLD_VIRTUAL_PS1";\n        export PS1;\n        unset _OLD_VIRTUAL_PS1;\n    fi;\n    unset VIRTUAL_ENV;\n    unset VIRTUAL_ENV_PROMPT;\n    if [ ! "${1-}" = "nondestructive" ]; then\n        unset -f virtualenv_deactivate;\n    fi\n}'
Git_create_new_repo () 
{ 
    reponame=$1;
    cd "$__SRC_GIT_GITOLITE_ADMIN_REPO" && ./add_repo.sh "$reponame"
}
Git_pushtocreate () 
{ 
    reponame=$1;
    repo_uri="${__SRC_GIT_URI}/${reponame}";
    username="westurner";
    here=$(pwd);
    repo_local_path=$2;
    remote_name=${__SRC_GIT_REMOTE_NAME};
    Git_create_new_repo "$reponame";
    ( cd "$repo_local_path" || return;
    git remote add "$remote_name" "$repo_uri" "${__SRC_GIT_URI}/${username}/${reponame}" && git push --all "$remote_name" && cd "$here" || return )
}
Hg () 
{ 
    path="${__SRC}/hg/$1";
    path=${path:-'.'};
    shift;
    cmd=("${@}");
    sudo -H -u hg -i /usr/bin/hg -R "${path}" "${cmd[@]}"
}
Hg_create_new_repo () 
{ 
    reponame=$1;
    ( cd "$__SRC_HG_SERVER_REMOTE_ADMIN" || return && ./add_repo.sh "$reponame" )
}
Hg_pushtocreate () 
{ 
    reponame=$1;
    repo_uri="${__SRC_HG_URI}/${reponame}";
    here=$(pwd);
    repo_local_path=$2;
    remote_name=${__SRC_HG_REMOTE_NAME}
}
Hgcheck () 
{ 
    path="${__SRC}/$1";
    path=${path:-'.'};
    shift;
    Hg "$path" tags;
    Hg "$path" id -n;
    Hg "$path" id;
    Hg "$path" branch
}
Hgclone () 
{ 
    url=$1;
    shift;
    path="${__SRC}/hg/$1";
    if [ -d "$path" ]; then
        echo "$path exists. Exiting." 1>&2;
        echo "see: update_repo $1";
        return 0;
    fi;
    sudo -u hg -i /usr/bin/hg clone "$url" "$path";
    fixperms "$path"
}
Hgcompare () 
{ 
    one=$1;
    two=$2;
    diff -Naur <(hg -R "${one}" log) <(hg -R "${two}" log)
}
Hglog () 
{ 
    path=$1;
    shift;
    Hg -R "$path" log "${@}"
}
Hgpull () 
