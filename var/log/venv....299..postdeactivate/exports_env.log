_rpmdev_bumpspec () 
{ 
    COMPREPLY=();
    local i;
    for i in ${COMP_WORDS[@]};
    do
        [[ "$i" == -@(h|-help|v|-version) ]] && return;
    done;
    local cur prev;
    _rpmdev_curprev "$2" "$3";
    [[ $prev == -@(c|-comment|u|-userstring) ]] && return;
    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W '--help --comment --userstring --rightmost
                                   --verbose --version' -- "$cur"));
    else
        _filedir spec;
        if [[ $cur != .* ]]; then
            for i in ${!COMPREPLY[@]};
            do
                [[ ${COMPREPLY[i]} == .@(git|svn) ]] && unset COMPREPLY[i];
            done;
        fi;
    fi;
    _rpmdev_uniqargs
}
_rpmdev_curprev () 
{ 
    if declare -F _get_comp_words_by_ref &> /dev/null; then
        _get_comp_words_by_ref cur prev;
    else
        cur=$1 prev=$2;
    fi
}
_rpmdev_diff () 
{ 
