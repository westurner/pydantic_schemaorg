_rpmdev_uniqargs () 
{ 
    local i j;
    for i in ${!COMPREPLY[@]};
    do
        for ((j=0; j < ${#COMP_WORDS[@]}; j++ ))
        do
            if [[ $j -ne $COMP_CWORD && ${COMPREPLY[i]} == ${COMP_WORDS[j]} ]]; then
                unset COMPREPLY[i];
                break;
            fi;
        done;
    done
}
