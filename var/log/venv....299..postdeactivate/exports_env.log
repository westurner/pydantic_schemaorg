deduplicate_lines () 
{ 
    local -A lines_ary;
    local line;
    local lines_ary_value;
    while IFS= read -r line; do
        lines_ary_value=${lines_ary["${line}"]};
        if [ -z "${lines_ary_value}" ]; then
            lines_ary["${line}"]="${line}";
            echo "${line}";
        fi;
    done;
    unset lines_ary line lines_ary_value
}
