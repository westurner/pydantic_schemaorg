ensure_symlink () 
{ 
    _from=$1;
    _to=$2;
    _date=${3:-$(date +%FT%T%z)};
    if [ -s "${_from}" ]; then
        _to_path=$(realpath "$_to");
        _from_path=$(realpath "$_from");
        if [ "$_to_path" == "$_from_path" ]; then
            printf "%s already points to %s" "$_from" "$_to";
        else
            printf "%s points to %s" "$_from" "$_to";
            mv -v "${_from}" "${_from}.bkp.${_date}";
            ln -v -s "${_to}" "${_from}";
        fi;
    else
        if [ -e "${_from}" ]; then
            printf "%s exists" "${_from}";
            mv -v "${_from}" "${_from}.bkp.${_date}";
            ln -v -s "${_to}" "${_from}";
        else
            ln -v -s "$_to" "$_from";
        fi;
    fi
}
