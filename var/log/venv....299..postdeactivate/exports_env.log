_purge_line () 
{ 
    if [ -s "$1" ]; then
        t=$(mktemp -t bashmarks.XXXXXX) || exit 1;
        trap "rm -f -- '$t'" EXIT;
        sed "/$2/d" "$1" > "$t";
        mv "$t" "$1";
        rm -f -- "$t";
        trap - EXIT;
    fi
